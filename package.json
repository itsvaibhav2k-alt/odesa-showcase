{
  "name": "odesa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:inngest": "npx --yes inngest-cli@latest dev -u http://localhost:3005/api/inngest",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "test:e2e:visual": "playwright test today/today-visual",
    "test:e2e:a11y": "playwright test today/today-a11y",
    "seed:owner-queue": "node --env-file=.env.local scripts/seed-owner-queue-proposals.mjs",
    "seed:inbox": "node --env-file=.env.local scripts/seed-inbox-conversations.mjs",
    "seed:demo:local": "supabase db reset && npm run seed:inbox",
    "seed:demo:full:local": "node scripts/seed-full-demo-local.mjs",
    "worker:operator": "tsx src/worker/inngest-server.ts",
    "check:sdk-leak": "node scripts/check-vercel-sdk-leak.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.126",
    "@anthropic-ai/sdk": "^0.88.0",
    "@base-ui/react": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@sentry/nextjs": "^10.73.0",
    "@stripe/stripe-js": "^8.10.0",
    "@studio-freight/lenis": "^1.0.42",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^6.2.1",
    "framer-motion": "^12.38.0",
    "googleapis": "^171.4.0",
    "inngest": "^4.2.1",
    "lucide-react": "^0.577.0",
    "next": "^16.2.10",
    "openai": "^6.36.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "^4.0.8",
    "stripe": "^20.4.1",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.37",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.0.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
