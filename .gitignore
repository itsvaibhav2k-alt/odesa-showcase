# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
playwright-report/
playwright-results.*
test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# superpowers brainstorming
.superpowers/
.claude/worktrees/
.agents/

# supabase CLI ephemeral state
supabase/.temp/
dogfood-output/

# retell provisioner sandbox state (scripts/retell-provision.ts)
.retell-sandbox-snapshot.json

# Private/generated publication exclusions (source tests remain tracked)
/.hermes/
/qa-output/
/WAVE0*
/design/**/*.png
/design/**/*.jpg
/design/**/*.jpeg
/design/**/*.webp
/design/**/capture-results.json
/e2e/__snapshots__/**/*.png
